%% Primera entrega de control de flujo: variables del ambito de main.
create_funk #declare_infinite_void# main() {
    n * declare_int : 5;
    resultado * declare_int : 0;
    whether (n < 3) {
        resultado : 10;
    }
    alif (n < 8) {
        resultado : 20;
    }
    also {
        resultado : 30;
    }
}
