%% Ejemplo de sintaxis; todavia no ejecuta las funciones.
create_funk #declare_int# clasificar(n * declare_int) {
    whether (n < 0) {
        give neumann 1;
    }
    alif (n == 0) {
        give 0;
    }
    alif (n < 10) {
        give 1;
    }
    also {
        give 2;
    }
}

create_funk #declare_infinite_void# main() {
    categoria * declare_int : clasificar(5);
}
