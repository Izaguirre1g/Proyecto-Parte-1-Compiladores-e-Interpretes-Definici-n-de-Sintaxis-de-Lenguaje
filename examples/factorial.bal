%% Ejercicio 1: factorial. El resultado esperado para n=5 es 120.
create_funk #declare_infinite_void# main() {
    n * declare_int : 5;
    resultado * declare_int : 1;
    i * declare_int : 2;

    whether (n <= 1) {
        resultado : 1;
    }
    also {
        whale (i <= n) {
            resultado : resultado pitagoras i;
            i : i gauss 1;
        } stop;
    }
}
