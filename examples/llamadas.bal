%% Ejemplo sintactico: todavia no se ejecutan las operaciones.
create_funk #declare_int# sumar(a * declare_int, b * declare_int) {
    give a gauss b;
}

create_funk #declare_infinite_void# saludar() {
    give;
}

create_funk #declare_infinite_void# main() {
    resultado * declare_int : sumar(2, 3);
    resultado : sumar(resultado, sumar(4, 5));
    saludar();
}
