%% Resultado esperado: 3 vueltas y resultado = 21.
create_funk #declare_infinite_void# main() {
    i * declare_int : 0;
    resultado * declare_int : 0;
    whale (i < 3) {
        whether (i < 2) {
            resultado : resultado gauss 10;
        }
        also {
            resultado : resultado gauss 1;
        }
        i : i gauss 1;
    } stop;
}
